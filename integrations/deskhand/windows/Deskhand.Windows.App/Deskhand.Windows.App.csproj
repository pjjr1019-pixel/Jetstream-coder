<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Deskhand</AssemblyName>
    <RootNamespace>Deskhand.Windows.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\package-dependencies\embedded-node\win-x64\deskhand_tsnode.dll" Link="deskhand_tsnode.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\package-dependencies\embedded-node\win-x64\deskhand_tsnode.dll')" />
    <Content Include="..\package-dependencies\embedded-node\licenses\**\*" Link="embedded-node-licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Deskhand.Desktop.Specs" />
    <InternalsVisibleTo Include="Deskhand.Integration.Specs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\package-dependencies\ffmpeg\win-x64\*" Link="ffmpeg\win-x64\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assistant_service\*.py" Exclude="..\..\assistant_service\test_*.py" Link="assistant_service\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assistant_service\runtime\**\*" Link="assistant_service\runtime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\package-dependencies\python\**\*" Link="python\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\jettpad\**\*.py" Exclude="..\..\vendor\jettpad\backend\tests\**\*;..\..\vendor\jettpad\**\__pycache__\**\*" Link="jettpad\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\jettpad\browser-extension\*.js" Link="jettpad\browser-extension\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\jettpad-dependencies\site-packages\**\*" Link="jettpad-dependencies\site-packages\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assistant_service\requirements.txt" Link="assistant_service\requirements.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deskhand.Contracts\Deskhand.Contracts.csproj" />
    <ProjectReference Include="..\Deskhand.Core\Deskhand.Core.csproj" />
    <ProjectReference Include="..\Deskhand.Relay\Deskhand.Relay.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="deskhand.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
