<Project>
  <!--
    Deskhand version: SINGLE SOURCE OF TRUTH (B2-C, 100.030).

    DeskhandVersion is the one place the product version lives.
    - The Windows label (MainForm) reads it at runtime from the
      assembly: Application.ProductVersion returns
      InformationalVersion, which is set from DeskhandVersion here.
    - <Version> is set from it too, so every project under windows/
      (App, Core, Contracts, Relay, specs) reports the same version.
    - CHANGELOG.md is keyed to the same number by hand at deploy time
      (a text file cannot be generated by the build); add an entry
      there for each version that actually ships, never backfill
      versions that never shipped.
    - Android reads version.properties (B2-G); no such file exists in
      this snapshot, so its build.gradle.kts still falls back to 0.1.0.

    HOW TO BUMP: change ONLY DeskhandVersion below, at deploy time.
    Do not edit a version number in MainForm, a csproj, or the
    changelog to bump the app. The value below is the CURRENT
    shipping version (100.050).
  -->
  <PropertyGroup>
    <DeskhandVersion>100.051</DeskhandVersion>
    <Version>$(DeskhandVersion)</Version>
    <InformationalVersion>$(DeskhandVersion)</InformationalVersion>
  </PropertyGroup>
</Project>

